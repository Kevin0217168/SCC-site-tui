# ── 内容来源 ──────────────────────────────────────────────────────────
# 指向本机的内容 API（tools/content-api.ts），内容来自 content/ 目录。
# 若要改用远程 ska-web 站点，填它的根 URL（不要带 /api/v1）。
SKA_WEB_BASE_URL=http://127.0.0.1:8787

# 本地内容 API 的端口。
# 注意不要用 PORT，那个是 TUI 自己的端口，两者会互相覆盖。
CONTENT_API_PORT=8787

# 目录缓存有效期（毫秒）。内容源在本机时调小到 5000 可实现「存盘即见」；
# 留空或删掉则用默认的 30 分钟。
CONTENT_CACHE_TTL_MS=5000

# ── 墙内服务器适配 ────────────────────────────────────────────────────
# 代码块语法高亮的 wasm / 查询文件托管在 github.com，国内机房直连会超时，
# 导致高亮失效并拖慢首次渲染。填一个 GitHub 代理前缀即可绕开。
# 留空 = 不改写 URL（本地开发推荐留空）。
# 可选值：https://gh-proxy.com/  https://ghfast.top/  https://ghproxy.net/
GH_PROXY=

# ── AI 对话（不填则自动禁用）──────────────────────────────────────────
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=your-api-key-here
AI_MODEL=glm-5.1

# ── 记忆系统（可选，不填则自动禁用）───────────────────────────────────
# HINDSIGHT_API_URL=http://localhost:18888

# ── 运行参数 ──────────────────────────────────────────────────────────
OTUI_USE_CONSOLE=false
SHOW_CONSOLE=false

# TUI 的监听端口。
#   2222 —— 默认值，无需任何额外授权
#   22   —— 想要 `ssh user@host` 这种标准写法时用；但 1024 以下端口需要
#           额外授权（sysctl 或 setcap），而且**必须同时配好 SSH_AUTH**，
#           因为 22 是全互联网扫描量最大的端口
PORT=2222

# ── SSH 认证 ──────────────────────────────────────────────────────────
# 这是本项目最需要注意的安全开关：
#   open       不做任何认证。任何能连到该端口的人都会直接拿到一个会话，
#              可以使用你的 AI 额度。默认值，与历史行为一致。
#   publickey  只允许 SSH_AUTHORIZED_KEYS 里列出的密钥（推荐，尤其用于 22）
#   anykey     任何持有任意 SSH 私钥的客户端都能进（能挡掉无脑扫描器）
SSH_AUTH=open
# SSH_AUTH=publickey 时读取的公钥名单，默认 ~/.ssh/authorized_keys
# SSH_AUTHORIZED_KEYS=/home/mint/.ssh/authorized_keys

# 闲置多久自动断开连接（如 10m）。暴露在公网时建议设置，
# 避免扫描器或挂机客户端长期占住会话。
# SSH_IDLE_TIMEOUT=10m
