# ── 内容来源 ──────────────────────────────────────────────────────────
# 指向本机的内容 API（tools/content-api.ts），内容来自 content/ 目录。
# 若要改用远程 ska-web 站点，填它的根 URL（不要带 /api/v1）。
SKA_WEB_BASE_URL=http://127.0.0.1:8787

# 本地内容 API 的端口。
# 注意不要用 PORT，那个是 TUI 自己的端口，两者会互相覆盖。
CONTENT_API_PORT=8787

# 目录缓存有效期（毫秒）。内容源在本机时调小到 5000 可实现「存盘即见」；
# 留空或删掉则用默认的 30 分钟。
CONTENT_CACHE_TTL_MS=5000

# ── 墙内服务器适配 ────────────────────────────────────────────────────
# 代码块语法高亮的 wasm / 查询文件托管在 github.com，国内机房直连会超时，
# 导致高亮失效并拖慢首次渲染。填一个 GitHub 代理前缀即可绕开。
# 留空 = 不改写 URL（本地开发推荐留空）。
# 可选值：https://gh-proxy.com/  https://ghfast.top/  https://ghproxy.net/
GH_PROXY=

# ── AI 对话（不填则自动禁用）──────────────────────────────────────────
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=your-api-key-here
AI_MODEL=glm-5.1

# ── 记忆系统（可选，不填则自动禁用）───────────────────────────────────
# HINDSIGHT_API_URL=http://localhost:18888

# ── 运行参数 ──────────────────────────────────────────────────────────
OTUI_USE_CONSOLE=false
SHOW_CONSOLE=false
PORT=2222
