# ska-web 站点根 URL（不要带 /api/v1）
# 公开 API 目前部署在 ska-web `dev` 预览环境；未设置时使用该默认值。
SKA_WEB_BASE_URL=https://ska-web-git-dev-sakuraofficials-projects.vercel.app

# 记忆系统后端，可选，可以不填
HINDSIGHT_API_URL=http://localhost:18888

AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # 或任何 OpenAI 兼容 API
AI_API_KEY=your-api-key-here
AI_MODEL=glm-5.1                   # 模型名

OTUI_USE_CONSOLE=false
SHOW_CONSOLE=false
PORT=2222
