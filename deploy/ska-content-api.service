[Unit]
Description=SCC-site-tui 本地内容 API（content/*.md -> ska-web Public API v1）
Documentation=https://github.com/Kevin0217168/SCC-site-tui
After=network.target

[Service]
Type=simple
# @PROJECT_DIR@ 是占位符，安装时替换为实际绝对路径。
# 必须是项目根目录：内容目录 content/ 是相对路径解析的。
WorkingDirectory=@PROJECT_DIR@
ExecStart=%h/.bun/bin/bun run @PROJECT_DIR@/tools/content-api.ts
Restart=on-failure
RestartSec=3
# 端口从项目根的 .env 读取（CONTENT_API_PORT，默认 8787）

[Install]
WantedBy=default.target
